<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Tem Perto</title>
<style>
:root{
 --cyan:#00A6CE;--deep:#007FA3;--pale:#E8F9FD;
 --ink:#183744;--muted:#78909A;--line:#E5EFF2;--white:#fff;
 --green:#1E9E63;--green-bg:#E8F8F0;
 --orange:#D97706;--orange-bg:#FEF3C7;
 --red:#DC2626;--red-bg:#FEE2E2;
}
*{box-sizing:border-box}
body{margin:0;background:#EAF3F6;color:var(--ink);
 font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
.app{max-width:440px;min-height:100vh;margin:auto;background:white;
 padding-bottom:85px;position:relative;box-shadow:0 0 45px #164b5b12}
header{height:76px;padding:14px 20px;display:flex;justify-content:space-between;
 align-items:center;background:white;border-bottom:1px solid #f0f5f7;
 position:sticky;top:0;z-index:5}
.logo{font-size:25px;font-weight:900;letter-spacing:-1.5px;color:var(--deep)}
.logo span{color:var(--cyan)}
.location{font-size:10px;color:var(--muted);margin-top:3px}
.avatar{width:42px;height:42px;border:1.5px solid #BCE7F2;border-radius:50%;
 background:var(--pale);color:var(--deep);font-weight:850;padding:0;
 overflow:hidden;display:grid;place-items:center}
.avatar img{width:100%;height:100%;object-fit:cover}
main{padding:18px 19px}
h1{font-size:25px;letter-spacing:-.8px;margin:5px 0 7px}
h2{font-size:19px;margin:0;letter-spacing:-.4px}
h3{font-size:14px;margin:0}
p{line-height:1.5}
.muted{font-size:12px;color:var(--muted)}
.eyebrow{font-size:10px;letter-spacing:1.4px;text-transform:uppercase;
 color:var(--deep);font-weight:850}

/* TELA DE ENTRADA (ONBOARDING) */
.welcome-wrap{padding:26px 20px 30px;min-height:100vh;display:flex;flex-direction:column;justify-content:center}
.welcome-head{text-align:center;margin-bottom:24px}
.welcome-head .logo{font-size:32px;margin-bottom:8px}
.welcome-head h1{font-size:23px;line-height:1.2;margin:8px 0}
.welcome-head p{font-size:13px;color:#547784;margin:0}
.role-card{display:flex;align-items:center;gap:14px;width:100%;text-align:left;
 background:white;border:2px solid var(--line);border-radius:20px;
 padding:16px;margin-bottom:14px;transition:all .18s;position:relative}
.role-card:hover{border-color:var(--cyan);background:#F8FDFF;transform:translateY(-2px);
 box-shadow:0 10px 24px #00a6ce18}
.role-card-art{width:76px;height:82px;flex-shrink:0;background:var(--pale);
 border-radius:15px;display:grid;place-items:center;padding:4px}
.role-card-art svg{width:100%;height:100%}
.role-card-body{flex:1;min-width:0}
.role-badge{display:inline-block;background:var(--pale);color:var(--deep);
 font-size:10px;font-weight:800;padding:4px 9px;border-radius:20px;margin-bottom:6px}
.role-card h2{font-size:17px;margin-bottom:4px;color:var(--ink)}
.role-card p{font-size:11.5px;color:#547784;margin:0;line-height:1.45}
.role-examples{font-size:10.5px;color:var(--deep);font-weight:700;margin-top:7px}
.welcome-footer{text-align:center;margin-top:16px;font-size:11px;color:var(--muted)}

/* UPLOAD DE FOTO DE PERFIL */
.photo-picker{display:flex;flex-direction:column;align-items:center;
 background:var(--pale);border-radius:18px;padding:16px;margin:14px 0 18px}
.photo-circle{width:86px;height:86px;border-radius:50%;background:white;
 border:2.5px dashed #8AD4E6;display:grid;place-items:center;
 overflow:hidden;color:var(--deep);font-size:28px;margin-bottom:10px}
.photo-circle img{width:100%;height:100%;object-fit:cover}
.photo-btn{background:white;color:var(--deep);border:1px solid #BCE7F2;
 border-radius:10px;padding:8px 14px;font-size:11.5px;font-weight:800}

/* CHIPS DE CATEGORIAS DO PROFISSIONAL */
.chip-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:6px}
.chip-option{display:flex;align-items:center;gap:8px;border:1.5px solid var(--line);
 border-radius:11px;padding:10px 12px;font-size:12px;font-weight:700;background:#FBFDFE;cursor:pointer}
.chip-option input{accent-color:var(--cyan);width:16px;height:16px;margin:0}

/* CREDIBILIDADE E MARCADORES */
.cred-badge{display:inline-flex;align-items:center;gap:6px;padding:5px 11px;
 border-radius:30px;font-size:11px;font-weight:850}
.cred-new{background:#E8F4F8;color:var(--deep)}
.cred-green{background:var(--green-bg);color:var(--green)}
.cred-orange{background:var(--orange-bg);color:var(--orange)}
.cred-red{background:var(--red-bg);color:var(--red)}
.cred-dot{width:8px;height:8px;border-radius:50%;background:currentColor}
.progress-track{width:100%;height:8px;background:#E5EFF2;border-radius:99px;overflow:hidden;margin:10px 0 6px}
.progress-fill{height:100%;background:var(--cyan);border-radius:99px;transition:width .3s}
.rule-box{border-left:3.5px solid var(--cyan);padding:10px 12px;background:#F7FCFD;
 border-radius:0 12px 12px 0;margin-bottom:9px;font-size:11.5px;line-height:1.45}
.rule-box.green{border-left-color:var(--green);background:#F3FBF7}
.rule-box.orange{border-left-color:var(--orange);background:#FFFBEB}
.rule-box.red{border-left-color:var(--red);background:#FEF2F2}

.hero{display:flex;align-items:center;gap:6px;background:var(--pale);
 border-radius:21px;padding:16px 14px 16px 18px;min-height:178px;overflow:hidden}
.hero-copy{flex:1;min-width:0}
.hero h1{font-size:23px;line-height:1.13}
.hero p{font-size:11px;color:#547784;margin:8px 0 13px}
.hero-art{width:142px;flex-shrink:0}
.hero-art svg{width:100%;height:auto;display:block}
.primary{background:var(--cyan);color:white;border:0;border-radius:11px;
 padding:12px 16px;font-size:12px;font-weight:800}
.secondary{background:white;color:var(--deep);border:1px solid #D9EDF2;
 border-radius:10px;padding:10px 13px;font-size:12px;font-weight:750}
.danger-btn{background:#FFF5F5;color:#C93B3B;border:1px solid #FAD4D4;
 border-radius:11px;padding:12px 16px;font-size:12px;font-weight:800;margin-top:16px}
.full{width:100%}
.section{display:flex;justify-content:space-between;align-items:center;margin:24px 0 12px}
.link{background:none;border:0;color:var(--deep);font-size:11px;font-weight:800}
.categories{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.category{border:1px solid var(--line);border-radius:16px;background:white;
 padding:8px 4px 11px;text-align:center;min-width:0;transition:transform .15s,border-color .15s}
.category:hover{transform:translateY(-2px);border-color:#BCE7F2}
.category svg{width:100%;height:96px;display:block;margin-bottom:2px}
.category strong{font-size:11px;color:var(--ink)}
.card{border:1px solid var(--line);border-radius:16px;padding:15px;
 margin-bottom:11px;background:white}
.row{display:flex;align-items:center;gap:10px}
.between{display:flex;align-items:center;justify-content:space-between;gap:9px}
.pill{background:var(--pale);color:var(--deep);padding:6px 9px;
 border-radius:30px;font-size:10px;font-weight:800}
.price{font-size:21px;font-weight:900;color:var(--deep)}
.offer-title{font-size:14px;font-weight:800;margin:12px 0 6px}
.meta{font-size:11px;color:var(--muted);line-height:1.9}
.actions{display:flex;gap:8px;margin-top:13px}
.actions button{flex:1}
.profile-hero{background:var(--pale);border-radius:19px;padding:20px;text-align:center}
.profile-avatar{width:82px;height:82px;border-radius:50%;background:white;
 margin:0 auto 10px;display:grid;place-items:center;color:var(--deep);
 font-size:25px;font-weight:850;border:2.5px solid #CDEEF6;overflow:hidden}
.profile-avatar img{width:100%;height:100%;object-fit:cover}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:15px}
.stat{background:white;border-radius:12px;padding:10px 3px}
.stat strong{display:block;color:var(--deep);font-size:13px}
.stat small{font-size:9px;color:var(--muted)}
.menu-item{display:flex;align-items:center;gap:12px;padding:14px 2px;
 width:100%;background:white;border:0;border-bottom:1px solid var(--line);
 text-align:left;color:var(--ink)}
.menu-icon{width:37px;height:37px;background:var(--pale);border-radius:11px;
 display:grid;place-items:center;color:var(--deep);font-size:17px}
.menu-item strong{font-size:12px}
.menu-item small{display:block;font-size:10px;color:var(--muted);margin-top:3px}
.arrow{margin-left:auto;color:#9BB1BA}
.page{display:none}.page.active{display:block}
.form-group{margin:13px 0}
.form-group label{font-size:11px;font-weight:800;display:block;margin-bottom:6px}
.form-group input,.form-group select,.form-group textarea{
 width:100%;border:1px solid var(--line);border-radius:10px;
 background:#FBFDFE;padding:12px;font-size:12px;color:var(--ink);outline:none}
.form-group textarea{min-height:75px;resize:vertical}
.form-group input:focus,.form-group textarea:focus{border-color:var(--cyan)}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.notice{background:#F0FAFC;padding:12px;border-radius:12px;
 font-size:11px;color:#537583;line-height:1.5}
.notice.warn{background:#FFF9EB;color:#7C5D18;border:1px solid #F7E3B5}
.notice.danger{background:var(--red-bg);color:var(--red);border:1px solid #FCA5A5}
.notice.success{background:var(--green-bg);color:var(--green);border:1px solid #A7F3D0}
.empty{padding:26px 14px;background:#F7FBFC;border-radius:15px;
 text-align:center;color:var(--muted);font-size:12px}
.bottom{position:fixed;bottom:0;left:50%;transform:translateX(-50%);
 width:min(440px,100%);height:72px;background:white;border-top:1px solid var(--line);
 display:flex;justify-content:space-around;align-items:center;z-index:8}
.nav{border:0;background:none;color:#91A7B0;font-size:9px;font-weight:750;
 display:flex;flex-direction:column;align-items:center;gap:4px;min-width:55px}
.nav b{font-size:20px;font-weight:500}
.nav.active{color:var(--deep)}
.nav.publish b{background:var(--cyan);color:white;border-radius:13px;
 width:39px;height:39px;display:grid;place-items:center;margin-top:-17px;
 font-size:25px;box-shadow:0 5px 14px #00a6ce40}
.toast{display:none;position:fixed;z-index:30;bottom:85px;left:50%;
 transform:translateX(-50%);background:var(--deep);color:white;
 padding:12px 18px;border-radius:12px;font-size:12px;width:max-content;max-width:90%}
hr{border:0;border-top:1px solid var(--line);margin:13px 0}
.hidden{display:none!important}

/* TABELA DE PISOS DE PREÇOS */
.price-table-box{background:#F7FBFC;border:1px solid var(--line);border-radius:14px;padding:12px;margin:12px 0;font-size:11px}
.price-table-row{display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid #EAEFEF}
.price-table-row:last-child{border-bottom:0}
.price-table-row small{display:block;font-size:10px;color:var(--muted);font-weight:400;margin-top:1px}

/* CHAT INTERNO */
.chat-box{background:#F4F9FB;border:1px solid var(--line);border-radius:14px;padding:12px;min-height:240px;max-height:320px;overflow-y:auto;display:flex;flex-direction:column;gap:8px;margin:12px 0}
.msg{max-width:80%;padding:9px 12px;border-radius:14px;font-size:12px;line-height:1.4}
.msg.me{align-self:flex-end;background:var(--cyan);color:white;border-bottom-right-radius:4px}
.msg.other{align-self:flex-start;background:white;border:1px solid var(--line);color:var(--ink);border-bottom-left-radius:4px}
.msg small{display:block;font-size:9px;opacity:.75;margin-top:3px}

/* GORJETAS E RECARGA */
.tip-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:10px 0}
.tip-btn{background:white;border:1.5px solid #BCE7F2;color:var(--deep);border-radius:10px;padding:9px 4px;font-size:12px;font-weight:800}
.tip-btn:hover{background:var(--pale);border-color:var(--cyan)}

/* MODAL / JANELINHA SOBREPOSTA */
.modal-backdrop{position:fixed;inset:0;background:#18374475;z-index:25;display:flex;align-items:center;justify-content:center;padding:18px}
.modal-card{background:white;border-radius:20px;padding:20px;width:100%;max-width:390px;box-shadow:0 15px 40px #00000025}

@media(min-width:600px){
 .app{margin:25px auto;min-height:calc(100vh - 50px);border-radius:25px;overflow:hidden}
 .bottom{bottom:25px;border-radius:0 0 25px 25px}
}
</style>
</head>
<body>
<div class="app" id="appContainer">

<!-- TELA 1: ENTRADA / ESCOLHA DE PERFIL -->
<section class="page active" id="welcome">
 <div class="welcome-wrap">
  <div class="welcome-head">
   <div class="logo">tem <span>perto.</span></div>
   <div class="eyebrow">Bem-vindo ao aplicativo</div>
   <h1>Como você quer usar o Tem Perto hoje?</h1>
   <p>Escolha a sua opção abaixo para criar sua conta e acessar o ambiente certo para você.</p>
  </div>

  <button class="role-card" onclick="startOnboarding('cliente')">
   <div class="role-card-art">
    <svg viewBox="0 0 170 185">
     <ellipse cx="85" cy="173" rx="52" ry="7" fill="#CBEBF3"/>
     <path d="M142 35L145 43L153 46L145 49L142 57L139 49L131 46L139 43Z" fill="#FFC857"/>
     <path d="M114 102C128 96 138 82 141 68" stroke="#183744" stroke-width="15" stroke-linecap="round"/>
     <path d="M114 102C128 96 138 82 141 68" stroke="#F8D2BA" stroke-width="10" stroke-linecap="round"/>
     <circle cx="142" cy="65" r="8" fill="#F8D2BA" stroke="#183744" stroke-width="2.5"/>
     <path d="M52 102C52 91 66 86 85 86C104 86 118 91 118 102L123 166H47L52 102Z" fill="#00A6CE" stroke="#183744" stroke-width="3" stroke-linejoin="round"/>
     <path d="M71 87C75 96 95 96 99 87" fill="#FFFFFF" stroke="#183744" stroke-width="2.5" stroke-linecap="round"/>
     <rect x="77" y="73" width="16" height="17" rx="6" fill="#F8D2BA" stroke="#183744" stroke-width="2.8"/>
     <rect x="55" y="21" width="60" height="58" rx="28" fill="#F8D2BA" stroke="#183744" stroke-width="3"/>
     <path d="M53 46C51 23 68 12 88 13C107 14 119 26 117 46C113 35 104 31 94 31C83 31 74 37 64 36C58 36 55 40 53 46Z" fill="#233D4D" stroke="#183744" stroke-width="3" stroke-linejoin="round"/>
     <circle cx="72" cy="49" r="3.5" fill="#183744"/><circle cx="98" cy="49" r="3.5" fill="#183744"/>
     <path d="M78 58Q85 66 92 58" stroke="#183744" stroke-width="2.8" fill="none" stroke-linecap="round"/>
    </svg>
   </div>
   <div class="role-card-body">
    <span class="role-badge">Quero contratar</span>
    <h2>Sou Cliente</h2>
    <p>Para você que precisa resolver algo em casa ou no trabalho com rapidez e segurança.</p>
    <div class="role-examples">Ex.: Preciso de faxina, eletricista, encanador, pintura...</div>
   </div>
  </button>

  <button class="role-card" onclick="startOnboarding('profissional')">
   <div class="role-card-art">
    <svg viewBox="0 0 170 185">
     <ellipse cx="85" cy="173" rx="52" ry="7" fill="#CBEBF3"/>
     <path d="M23 44L26 51L33 54L26 57L23 64L20 57L13 54L20 51Z" fill="#FFC857"/>
     <path d="M51 102C51 91 66 86 85 86C104 86 119 91 119 102L124 166H46L51 102Z" fill="#007FA3" stroke="#183744" stroke-width="3" stroke-linejoin="round"/>
     <path d="M68 87L85 108L102 87Z" fill="#FFFFFF" stroke="#183744" stroke-width="2.5" stroke-linejoin="round"/>
     <rect x="77" y="73" width="16" height="17" rx="6" fill="#F8D2BA" stroke="#183744" stroke-width="2.8"/>
     <rect x="55" y="23" width="60" height="56" rx="27" fill="#F8D2BA" stroke="#183744" stroke-width="3"/>
     <path d="M54 36C54 18 68 11 85 11C102 11 116 18 116 36Z" fill="#00A6CE" stroke="#183744" stroke-width="3" stroke-linejoin="round"/>
     <path d="M53 35C72 31 105 31 126 37C121 41 96 40 53 35Z" fill="#007FA3" stroke="#183744" stroke-width="2.8" stroke-linejoin="round"/>
     <circle cx="72" cy="51" r="3.5" fill="#183744"/><circle cx="98" cy="51" r="3.5" fill="#183744"/>
     <path d="M77 60Q85 68 93 60" stroke="#183744" stroke-width="2.8" fill="none" stroke-linecap="round"/>
    </svg>
   </div>
   <div class="role-card-body">
    <span class="role-badge">Quero trabalhar</span>
    <h2>Sou Profissional</h2>
    <p>Para prestadores de serviço que querem encontrar clientes perto de casa e receber via Pix.</p>
    <div class="role-examples">Ex.: Diarista, eletricista, encanador, pintor, montador...</div>
   </div>
  </button>

  <div class="welcome-footer">
   Plataforma segura com validação OTP, LGPD e repasses automatizados.
  </div>
 </div>
</section>

<!-- TELA 2: CADASTRO DO USUÁRIO (COM LGPD E TERMOS) -->
<section class="page" id="register">
 <div style="padding:20px 19px 30px">
  <button class="link" onclick="showWelcome()">← Voltar para escolha de perfil</button>
  <div class="eyebrow" style="margin-top:14px" id="regEyebrow">Cadastro de Cliente</div>
  <h1 id="regTitle">Crie sua conta</h1>
  <p class="muted" id="regSub">Preencha seus dados corretamente para usar o aplicativo com segurança.</p>

  <form id="registerForm">
   <div class="photo-picker">
    <div class="photo-circle" id="photoPreview">📷</div>
    <input type="file" id="photoInput" accept="image/*" class="hidden" onchange="previewPhoto(event)">
    <button type="button" class="photo-btn" onclick="document.getElementById('photoInput').click()">Escolher foto de perfil</button>
    <small class="muted" style="font-size:10px;margin-top:6px">Uma foto nítida ajuda a gerar confiança</small>
   </div>

   <div class="form-group">
    <label>Nome completo *</label>
    <input id="regName" placeholder="Digite seu nome completo" required>
   </div>

   <div class="grid-2">
    <div class="form-group">
     <label>CPF *</label>
     <input id="regCpf" placeholder="000.000.000-00" maxlength="14" required>
    </div>
    <div class="form-group">
     <label>Telefone / WhatsApp *</label>
     <input id="regPhone" placeholder="(81) 99999-9999" required>
    </div>
   </div>

   <div class="form-group">
    <label>Endereço de e-mail *</label>
    <input type="email" id="regEmail" placeholder="seuemail@exemplo.com" required>
   </div>

   <hr>
   <div class="eyebrow" style="margin-bottom:4px">Endereço físico</div>

   <div class="grid-2">
    <div class="form-group">
     <label>CEP *</label>
     <input id="regCep" placeholder="00000-000" required>
    </div>
    <div class="form-group">
     <label>Cidade *</label>
     <input id="regCity" placeholder="Ex.: Recife" required>
    </div>
   </div>

   <div class="form-group">
    <label>Rua, número e complemento *</label>
    <input id="regAddress" placeholder="Ex.: Rua das Flores, 120, Apto 201" required>
   </div>

   <div class="form-group">
    <label>Bairro *</label>
    <input id="regNeighborhood" placeholder="Seu bairro" required>
   </div>

   <div id="proExtraFields" class="hidden">
    <hr>
    <div class="eyebrow" style="margin-bottom:6px">Área de atuação e repasse</div>
    <div class="form-group">
     <label>Quais serviços você realiza? *</label>
     <div class="chip-grid">
      <label class="chip-option"><input type="checkbox" value="Limpeza" checked> Limpeza</label>
      <label class="chip-option"><input type="checkbox" value="Eletricista"> Eletricista</label>
      <label class="chip-option"><input type="checkbox" value="Encanador"> Encanador</label>
      <label class="chip-option"><input type="checkbox" value="Pintura"> Pintura</label>
      <label class="chip-option"><input type="checkbox" value="Montagem"> Montagem</label>
      <label class="chip-option"><input type="checkbox" value="Jardinagem"> Jardinagem</label>
     </div>
    </div>

    <div class="form-group">
     <label>Chave Pix para recebimento (mesmo CPF do cadastro) *</label>
     <input id="regPix" placeholder="Informe sua chave Pix (CPF, e-mail ou celular)">
    </div>

    <div class="notice warn">
     <strong>Regra de titularidade bancária:</strong> Os repasses via Pix são enviados exclusivamente para contas vinculadas ao <strong>mesmo CPF</strong> do cadastro.
    </div>
   </div>

   <!-- LGPD E TERMOS DE USO OBRIGATÓRIOS -->
   <div class="form-group" style="margin-top:16px;display:flex;align-items:flex-start;gap:10px">
    <input type="checkbox" id="lgpdCheck" required style="width:18px;height:18px;margin-top:2px;accent-color:var(--cyan)">
    <label for="lgpdCheck" style="font-weight:400;font-size:11px;line-height:1.4">
     Declaro que li e concordo com os <strong>Termos de Uso</strong> e a <strong>Política de Privacidade (LGPD)</strong> da Tem Perto, autorizando o tratamento seguro dos meus dados cadastrais e geolocalização.
    </label>
   </div>

   <br>
   <button class="primary full" type="submit" id="regSubmitBtn">Prosseguir para verificação SMS</button>
  </form>
 </div>
</section>

<!-- TELA 2.1: VALIDAÇÃO DE SEGURANÇA (SMS / OTP) -->
<section class="page" id="otpVerify">
 <div class="welcome-wrap" style="text-align:center">
  <div class="logo">tem <span>perto.</span></div>
