 updateAvatarUI(); renderCategories(); renderProfile(); renderProOffers(); renderRecent(); renderWallet();
 go('home');
 showToast(isPro ? 'Bem-vindo(a) à área do Profissional!' : 'Cadastro verificado com sucesso!');
}

