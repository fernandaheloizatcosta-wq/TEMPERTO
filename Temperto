document.getElementById('registerForm').addEventListener('submit', e => {
 e.preventDefault();
 const isPro = role === 'profissional';
 const selectedSkills = Array.from(document.querySelectorAll('#proExtraFields input[type="checkbox"]:checked')).map(cb => cb.value);
 if (isPro && selectedSkills.length === 0) { showToast('Selecione pelo menos uma categoria.'); return; }
 if (!document.getElementById('lgpdCheck').checked) { showToast('Você precisa aceitar os Termos e a Política de Privacidade (LGPD).'); return; }

 user.name = document.getElementById('regName').value.trim();
 user.cpf = document.getElementById('regCpf').value.trim();
 user.phone = document.getElementById('regPhone').value.trim();
 user.email = document.getElementById('regEmail').value.trim();
 user.cep = document.getElementById('regCep').value.trim();
 user.city = document.getElementById('regCity').value.trim();
 user.address = document.getElementById('regAddress').value.trim();
 user.neighborhood = document.getElementById('regNeighborhood').value.trim();
 user.pix = isPro ? document.getElementById('regPix').value.trim() : '';
 user.skills = isPro ? selectedSkills : [];

 // Vai para tela de validação SMS (OTP)
 showOnlyScreen('otpVerify');
 showToast('📲 Código de confirmação enviado via SMS para ' + user.phone);
});

function validateOtpAndEnter() {
 const otp = document.getElementById('otpCodeInput').value.trim();
 if (otp.length < 4) { showToast('Digite o código SMS de 4 dígitos.'); return; }
 enterApp();
}

function enterApp() {
 const isPro = role === 'profissional';
 document.getElementById('otpVerify').classList.remove('active');
 document.getElementById('appHeader').classList.remove('hidden');
 document.getElementById('appMain').classList.remove('hidden');
 document.getElementById('appBottomNav').classList.remove('hidden');
 document.getElementById('navPublishBtn').classList.toggle('hidden', isPro);
 document.getElementById('navServicesLabel').textContent = isPro ? 'Serviços' : 'Pedidos';

 const firstName = user.name.split(' ')[0] || 'Usuário';
 document.getElementById('headerLocation').textContent = `⌖ ${user.neighborhood}, ${user.city}`;
 document.getElementById('clientGreeting').textContent = `Olá, ${firstName}!`;
 document.getElementById('proGreeting').textContent = `Olá, ${firstName} · Profissional`;

 if (!isPro) {
  document.getElementById('cep').value = user.cep;
  document.getElementById('address').value = user.address;
  document.getElementById('neighborhood').value = user.neighborhood;
  document.getElementById('city').value = user.city;
