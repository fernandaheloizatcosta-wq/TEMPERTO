};

const money = v => 'R$ ' + Number(v).toFixed(2).replace('.', ',');
const categories = [['Limpeza','🧹'],['Eletricista','🔧'],['Encanador','🚿'],['Pintura','🖌️'],['Montagem','🪛'],['Jardinagem','🌱']];

function getCredInfo() {
 if (cred.status === 'red') return { badgeClass: 'cred-red', shortLabel: '3.0 · Bloqueado', title: 'Credibilidade 3.0 — Conta Suspensa (15 dias)', desc: 'Desistências excessivas. Novas ofertas suspensas por 15 dias.' };
 if (cred.status === 'orange') return { badgeClass: 'cred-orange', shortLabel: '6.5 · Atenção', title: `Credibilidade 6.5 — Recuperação (${cred.recoveryStreak}/10)`, desc: `Conclua mais ${10 - cred.recoveryStreak} trabalhos seguidos sem desistir para voltar à nota 9.5!` };
 if (cred.status === 'green') {
  const metaOk = cred.weeklyCompleted >= 5;
  return { badgeClass: metaOk ? 'cred-green' : 'cred-orange', shortLabel: `${cred.score.toFixed(1)} · ${metaOk ? 'Fluxo Ativo' : 'Meta Semanal'}`, title: `Credibilidade ${cred.score.toFixed(1)} — ${metaOk ? 'Fluxo Contínuo Ativo!' : 'Atenção à Meta Semanal'}`, desc: metaOk ? `Meta semanal atingida (${cred.weeklyCompleted}/5 serviços). Recebimentos via Pix garantidos!` : `Concluídos ${cred.weeklyCompleted}/5 serviços. Conclua mais ${5 - cred.weeklyCompleted} para garantir fluxo contínuo.` };
 }
 const faltam = Math.max(0, 5 - cred.completedPixJobs);
 return { badgeClass: 'cred-new', shortLabel: `Novato (${cred.completedPixJobs}/5)`, title: `Perfil Novato — Em construção (${cred.completedPixJobs} de 5)`, desc: `Conclua mais ${faltam} trabalho(s) com Pix sem desistências para liberar nota 9.5.` };
}

function registerCompletedJobWithPix() {
 cred.completedPixJobs++; cred.weeklyCompleted++;
 if (cred.status === 'new') {
  if (cred.completedPixJobs >= 5 && cred.cancellationsAfterAccept === 0) { cred.status = 'green'; cred.score = 9.5; showToast('🎉 5 serviços concluídos! Credibilidade 9.5 conquistada!'); }
 } else if (cred.status === 'orange') {
  cred.recoveryStreak++;
  if (cred.recoveryStreak >= 10) { cred.status = 'green'; cred.score = 9.5; cred.recoveryStreak = 0; showToast('🟢 Credibilidade recuperada para 9.5!'); }
  else { cred.score = Number((6.5 + (cred.recoveryStreak * 0.3)).toFixed(1)); }
 }
}

function registerAcceptedJobCancellation() {
 cred.cancellationsAfterAccept++; cred.recoveryStreak = 0;
 if (cred.status === 'red') return;
 if (cred.status === 'orange') { cred.status = 'red'; cred.score = 3.0; cred.suspendedDays = 15; showToast('🔴 Credibilidade 3.0! Conta suspensa por 15 dias.'); }
 else if (cred.cancellationsAfterAccept >= 3) { cred.status = 'orange'; cred.score = 6.5; showToast('🟠 3 desistências. Credibilidade caiu para 6.5.'); }
 else { showToast(`⚠️ Desistência registrada (${cred.cancellationsAfterAccept}/3).`); }
}

function startOnboarding(selectedRole) {
 role = selectedRole;
 const isPro = role === 'profissional';
 document.getElementById('regEyebrow').textContent = isPro ? 'Cadastro de Profissional' : 'Cadastro de Cliente';
 document.getElementById('regTitle').textContent = isPro ? 'Cadastre-se para trabalhar' : 'Crie sua conta de cliente';
 document.getElementById('proExtraFields').classList.toggle('hidden', !isPro);
 document.getElementById('regPix').required = isPro;
 showOnlyScreen('register');
 window.scrollTo({top: 0, behavior: 'smooth'});
}

function showWelcome() { showOnlyScreen('welcome'); }
function showOnlyScreen(screenId) {
 document.getElementById('appHeader').classList.add('hidden');
 document.getElementById('appMain').classList.add('hidden');
 document.getElementById('appBottomNav').classList.add('hidden');
 document.querySelectorAll('.page').forEach(x => x.classList.remove('active'));
 document.getElementById(screenId).classList.add('active');
}

function previewPhoto(event) {
 const file = event.target.files[0];
 if (!file) return;
 const reader = new FileReader();
 reader.onload = e => { user.photo = e.target.result; document.getElementById('photoPreview').innerHTML = `<img src="${user.photo}" alt="Avatar">`; };
 reader.readAsDataURL(file);
}

document.getElementById('regCpf').addEventListener('input', e => {
 let v = e.target.value.replace(/\D/g, '').slice(0, 11);
 v = v.replace(/(\d{3})(\d)/, '$1.$2'); v = v.replace(/(\d{3})(\d)/, '$1.$2'); v = v.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
 e.target.value = v;
});

