let cred = { completedPixJobs: 0, weeklyCompleted: 0, cancellationsAfterAccept: 0, status: 'new', score: null, recoveryStreak: 0, suspendedDays: 0 };
let requests = [];
let accepted = [];
let clientWalletBalance = 0;
let proEarnedBalance = 0;
let currentDraft = null;
let activeChatOrderId = null;
let activeTipOrderId = null;

let assignedProDemo = {
 name: 'Carlos Eduardo Silva',
 role: 'Profissional Verificado',
 score: '9.5',
