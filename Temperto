 {id:'a',category:'Limpeza',description:'Limpeza completa de apartamento (até 4h)',neighborhood:'Boa Viagem',city:'Recife',date:todayStr,time:'09:00',gross:126,net:119.7,status:'Disponível',paid:true,chat:[{sender:'client',text:'Olá! O porteiro já está avisado.',time:'08:05'}]},
 {id:'b',category:'Pintura',description:'Pintura de parede interna da sala (até 4h)',neighborhood:'Casa Forte',city:'Recife',date:'21/11/2026',time:'14:00',gross:147,net:139.65,status:'Disponível',paid:true,chat:[]},
 {id:'c',category:'Montagem',description:'Montagem de guarda-roupa 4 portas (até 4h)',neighborhood:'Piedade',city:'Jaboatão',date:'22/11/2026',time:'10:00',gross:105,net:99.75,status:'Disponível',paid:true,chat:[]}
 ];
}
let sample=demoOffers();

function renderProOffers(){
 const info = getCredInfo();
 const availList = sample.filter(x=>x.status==='Disponível');

 document.getElementById('proStatWeek').textContent = `${cred.weeklyCompleted}/5`;
 document.getElementById('proStatDone').textContent = String(cred.completedPixJobs).padStart(2,'0');
 document.getElementById('proStatScore').textContent = info.shortLabel;

 const tipArea = document.getElementById('proTipsNotificationArea');
 tipArea.innerHTML = proReceivedTips.map(t => `
  <div class="notice success" style="margin-bottom:8px">
   🎉 <strong>Gorjeta recebida via Pix!</strong> O cliente <strong>${t.clientName}</strong> mandou uma gorjeta de <strong>${money(t.amount)}</strong> direto na sua conta!
  </div>
 `).join('');

 let progressHtml = '';
 if (cred.status === 'new') progressHtml = `<div class="progress-track"><div class="progress-fill" style="width:${Math.min(100,(cred.completedPixJobs/5)*100)}%"></div></div>`;
 else if (cred.status === 'green') progressHtml = `<div class="progress-track"><div class="progress-fill" style="width:${Math.min(100,(cred.weeklyCompleted/5)*100)}%;background:#1E9E63"></div></div>`;
 else if (cred.status === 'orange') progressHtml = `<div class="progress-track"><div class="progress-fill" style="width:${Math.min(100,(cred.recoveryStreak/10)*100)}%;background:#D97706"></div></div>`;

 document.getElementById('proHomeCredCard').innerHTML = `
  <div class="between">
   <span class="cred-badge ${info.badgeClass}"><span class="cred-dot"></span>${info.title}</span>
   <button class="link" onclick="go('perfil')">Ver regras</button>
  </div>
  ${progressHtml}
  <div class="muted" style="margin-top:6px;font-size:11px">${info.desc}</div>
 `;

 if (cred.status === 'red') {
  document.getElementById('proOffers').innerHTML = `<div class="notice danger"><strong>Conta suspensa por 15 dias (Nota 3.0)</strong><br>Novas ofertas temporariamente bloqueadas.</div>`;
  return;
 }

 document.getElementById('proOffers').innerHTML = availList.map(x=>offerCard(x,true,sample.indexOf(x))).join('') || '<div class="empty">Nenhuma oferta disponível agora.</div>';
}

function acceptOffer(i){
 if (cred.status === 'red') { showToast('Sua conta está suspensa por 15 dias.'); return; }
 const item=sample[i];
 if(!item||item.status!=='Disponível')return;
 item.status='Aceito';
 accepted.push(item);
 showToast('Oferta aceita! Chat disponível a partir das 08h do dia.');
 renderProOffers(); renderServices(); renderWallet();
}

function declineOffer(){ showToast('Oferta ignorada.'); }

/* ESTORNO AUTOMÁTICO SE O PROFISSIONAL DESISTIR */
function cancelAcceptedService(id) {
 const idx = accepted.findIndex(x => x.id === id);
 if (idx === -1) return;
 const item = accepted[idx];
 item.status = 'Disponível';
 accepted.splice(idx, 1);

 // Estorna o valor integral para a carteira do cliente
 clientWalletBalance += item.gross;

 registerAcceptedJobCancellation();
 renderServices(); renderProOffers(); renderProfile(); renderWallet();
 showToast(`⚠️ Serviço cancelado pelo profissional. Estorno automático de ${money(item.gross)} depositado na carteira do cliente.`);
}

function renderServices(){
 const box=document.getElementById('serviceContent');
 if(role==='cliente'){
  document.getElementById('serviceTitle').textContent='Meus pedidos';
  document.getElementById('serviceSub').textContent='Acompanhe seus pedidos, converse pelo chat no dia ou avalie o profissional.';
  box.innerHTML=requests.length?requests.map(x=>clientOrderCard(x)).join(''):'<div class="empty">Você ainda não publicou pedidos.<br><br><button class="primary" onclick="go(\'publicar\')">Criar meu primeiro pedido</button></div>';
 }else{
  document.getElementById('serviceTitle').textContent='Meus serviços';
  document.getElementById('serviceSub').textContent='Ofertas que você aceitou realizar.';
  box.innerHTML=accepted.length?accepted.map(x=>`
  <div class="card"><span class="pill">${x.status}</span><div class="offer-title">${x.description}</div>
  <div class="meta">⌖ ${x.neighborhood}, ${x.city}<br>◷ ${x.date} às ${x.time}</div>
  <div class="muted" style="margin-top:10px">Seu valor líquido</div>
  <div class="price">${money(x.net)}</div>
  ${!x.completed?`<div class="actions">
   <button class="secondary" onclick="openOrderChat('${x.id}')">💬 Abrir Chat</button>
   <button class="primary" onclick="completeService('${x.id}')">Concluir e receber Pix</button>
  </div>
  <button class="secondary full" style="margin-top:8px;color:#C93B3B;border-color:#FAD4D4" onclick="cancelAcceptedService('${x.id}')">Desistir do serviço</button>`
  :`<div class="notice success" style="margin-top:8px">✓ Serviço concluído. Chat fechado automaticamente.</div>`}</div>`).join(''):'<div class="empty">Você ainda não aceitou serviços.</div>';
 }
}

function clientMarkDone(id) {
 const item = requests.find(x => x.id === id);
 if (!item || item.status === 'Concluído') return;
 item.status = 'Concluído';
 item.completedAt = Date.now();
 renderServices();
 renderRecent();
 openTipModal(id);
}

function completeService(id){
 const item=accepted.find(x=>x.id===id);
 if(!item||item.completed)return;
 item.completed=true; item.status='Concluído'; item.completedAt = Date.now();
 proEarnedBalance+=item.net;
 showToast('Pix de '+money(item.net)+' enviado automaticamente! Chat fechado.');
 registerCompletedJobWithPix();
 renderServices(); renderWallet(); renderProOffers(); renderProfile();
}

function openTipModal(orderId) {
 activeTipOrderId = orderId;
 document.getElementById('tipProNameDisplay').textContent = assignedProDemo.name;
 document.getElementById('tipModalTitle').textContent = `Gorjeta para ${assignedProDemo.name.split(' ')[0]}`;
 document.getElementById('customTipInput').value = '';
 document.getElementById('tipModal').classList.remove('hidden');
}

function closeTipModal() {
 document.getElementById('tipModal').classList.add('hidden');
 activeTipOrderId = null;
}

function sendCustomTip() {
 const val = Number(document.getElementById('customTipInput').value);
 if (!val || val <= 0) { showToast('Informe um valor válido.'); return; }
 sendTip(val);
}

function sendTip(amount) {
 const item = requests.find(x => x.id === activeTipOrderId);
 if (!item) return;

 if (Date.now() - item.completedAt > 30 * 60 * 1000) {
  showToast('O prazo de 30 minutos após a conclusão já expirou.');
  closeTipModal();
  return;
 }

 if (clientWalletBalance >= amount) {
  clientWalletBalance -= amount;
 }

 item.tipSent = true;
 item.tipAmount = amount;

 proReceivedTips.unshift({
  clientName: user.name || 'Cliente',
  amount: amount,
  time: new Date().toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'})
 });

 closeTipModal();
 renderServices();
 renderWallet();
 showToast(`🎁 Gorjeta de ${money(amount)} enviada via Pix para ${assignedProDemo.name}!`);
}

function openProPublicProfile() {
 const hero = document.getElementById('publicProHero');
 hero.innerHTML = `
  <div class="profile-avatar">CE</div>
  <h2>${assignedProDemo.name}</h2>
  <div class="muted">${assignedProDemo.skills.join(' · ')}</div>
  <div style="margin-top:8px"><span class="cred-badge cred-green"><span class="cred-dot"></span>Nota ${assignedProDemo.score} · Credibilidade Ótima</span></div>
 `;
 renderPublicReviews();
 go('proPublicProfile');
}

function renderPublicReviews() {
 const list = document.getElementById('publicProReviews');
 list.innerHTML = assignedProDemo.reviews.map(r => `
  <div class="card">
   <div class="between"><strong>${r.author}</strong><small class="muted">${r.date}</small></div>
   <p style="margin:6px 0 0;font-size:12px">${r.text}</p>
  </div>
 `).join('');
}

function submitProReview() {
 const txt = document.getElementById('newReviewText').value.trim();
 if (!txt) { showToast('Escreva seu comentário.'); return; }
 assignedProDemo.reviews.unshift({
  author: user.name || 'Cliente Verificado',
  text: txt,
  date: new Date().toLocaleDateString('pt-BR')
 });
 document.getElementById('newReviewText').value = '';
 renderPublicReviews();
 showToast('Comentário salvo no perfil do profissional!');
}

function openOrderChat(orderId) {
 activeChatOrderId = orderId;
 const item = (role === 'cliente' ? requests : accepted).find(x => x.id === orderId);
 if (!item) return;

 const todayStr = new Date().toLocaleDateString('pt-BR');
 const currentHour = new Date().getHours();
 const isClosed = item.status === 'Concluído';

 const isServiceDay = item.date === todayStr;
 const isAfter8AM = currentHour >= 8;

 document.getElementById('chatHeaderTitle').textContent = `Chat · ${item.category}`;
 document.getElementById('chatHeaderSub').textContent = `Agendado para ${item.date} às ${item.time}`;

 const box = document.getElementById('chatMessagesBox');
 const inputArea = document.getElementById('chatInputArea');
 const closedNotice = document.getElementById('chatClosedNotice');

 if (isClosed) {
  inputArea.classList.add('hidden');
  closedNotice.textContent = 'Este serviço foi finalizado. O chat foi fechado automaticamente.';
  closedNotice.classList.remove('hidden');
 } else if (!isServiceDay || !isAfter8AM) {
  inputArea.classList.add('hidden');
  closedNotice.textContent = `O chat só é liberado no dia do serviço (${item.date}) a partir das 08:00 da manhã.`;
  closedNotice.classList.remove('hidden');
 } else {
  inputArea.classList.remove('hidden');
  closedNotice.classList.add('hidden');
 }

 renderChatMessages(item);
 go('chatPage');
}

function renderChatMessages(item) {
 const box = document.getElementById('chatMessagesBox');
 const msgs = item.chat || [];
 box.innerHTML = msgs.length ? msgs.map(m => `
  <div class="msg ${m.sender === role ? 'me' : 'other'}">
   ${m.text}
   <small>${m.time}</small>
  </div>
 `).join('') : '<div class="muted" style="text-align:center;margin:auto">Nenhuma mensagem ainda.</div>';
}

function sendChatMessage() {
 const input = document.getElementById('chatMsgInput');
 const text = input.value.trim();
 if (!text) return;
 const item = (role === 'cliente' ? requests : accepted).find(x => x.id === activeChatOrderId);
 if (!item || item.status === 'Concluído') return;

 if (!item.chat) item.chat = [];
 item.chat.push({
  sender: role,
  text: text,
  time: new Date().toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'})
 });
 input.value = '';
 renderChatMessages(item);
}

function addClientFunds(amount) {
 clientWalletBalance += amount;
 renderWallet();
 showToast(`✓ ${money(amount)} adicionados à sua carteira via Pix!`);
}

function addCustomClientFunds() {
 const val = Number(document.getElementById('customTopupInput').value);
 if (!val || val < 5) { showToast('Informe um valor mínimo de R$ 5,00.'); return; }
 document.getElementById('customTopupInput').value = '';
 addClientFunds(val);
}

function renderRecent(){
 document.getElementById('clientRecent').innerHTML=requests.length?
 clientOrderCard(requests[requests.length-1]):'<div class="empty">Seus pedidos aparecerão aqui.</div>';
}

document.getElementById('grossPrice').addEventListener('input',e=>{
 document.getElementById('customerTotal').textContent=money(Number(e.target.value)||0);
});

document.getElementById('requestForm').addEventListener('submit',e=>{
 e.preventDefault();
 const cat = document.getElementById('categoryInput').value;
 const price = Number(document.getElementById('grossPrice').value);
 const minAllowed = minPrices[cat] || 0;

 if (price < minAllowed) {
  showToast(`O valor para ${cat} não pode ser menor que o piso de ${money(minAllowed)}.`);
  return;
 }

 const date = document.getElementById('date').value;
 const time = document.getElementById('time').value;

 if (time < '09:00' || time > '17:00') {
  showToast('Os serviços só podem ser agendados entre 09:00 e 17:00.');
  return;
 }

 currentDraft={
 id:'r'+Date.now(), category:cat,
 description:document.getElementById('description').value,
 neighborhood:document.getElementById('neighborhood').value,
 city:document.getElementById('city').value,
 address:document.getElementById('address').value,
 date:date.split('-').reverse().join('/'), time,
 gross:price, net:price*.95, status:'Em andamento', paid:false,
 chat:[{sender:'profissional', text:`Olá! Recebi seu pedido de ${cat}. No dia ${date.split('-').reverse().join('/')} estarei disponível!`, time:'08:00'}],
 tipSent:false, tipAmount:0
 };
 document.getElementById('paymentAmount').textContent=money(price);
 go('pagamento');
});

function confirmPayment(){
 if(!currentDraft)return;
 const method = document.getElementById('paymentMethod').value;
 if (method === 'wallet') {
  if (clientWalletBalance < currentDraft.gross) {
   showToast('Saldo insuficiente na carteira. Adicione saldo ou escolha PIX direto.');
   return;
  }
  clientWalletBalance -= currentDraft.gross;
 }
 currentDraft.paid=true;
 requests.push(currentDraft);
 sample.unshift({...currentDraft, status:'Disponível'});
 currentDraft=null;
 showToast('Pagamento confirmado! Pedido publicado e profissionais notificados.');
 renderWallet();
 go('servicos');
}

function renderWallet(){
 const isPro = role === 'profissional';
 document.getElementById('walletHeading').textContent = 'Minha carteira';
 document.getElementById('walletSub').textContent = isPro ? 'Repasses automáticos via Pix no seu CPF.' : 'Adicione saldo para contratar serviços e enviar gorjetas.';
 document.getElementById('walletLabel').textContent = isPro ? 'Total já transferido via Pix' : 'Saldo disponível na carteira';
 document.getElementById('walletCpfNote').textContent = `Titular: ${user.name} · CPF: ${user.cpf}`;
 document.getElementById('availableBalance').textContent = money(isPro ? proEarnedBalance : clientWalletBalance);

 document.getElementById('clientTopupCard').classList.toggle('hidden', isPro);
 const bankCard = document.getElementById('proBankCard');
 bankCard.classList.toggle('hidden', !isPro);
 if (isPro) {
  document.getElementById('proBankInfo').innerHTML =
   `<strong>Titular:</strong> ${user.name}<br><strong>CPF Validado:</strong> ${user.cpf}<br><strong>Chave Pix:</strong> ${user.pix}`;
 }

 const waiting = accepted.filter(x=>!x.completed);
 document.getElementById('pendingBalance').innerHTML = (isPro && waiting.length) ?
  waiting.map(x=>`<div class="between"><span class="muted">${x.category}</span><b>${money(x.net)}</b></div><div class="muted" style="margin:5px 0 12px">Aguardando conclusão para envio automático do Pix</div>`).join('') :
  '<div class="muted">Nenhum valor pendente.</div>';

 const historyList = isPro ? accepted.filter(x=>x.completed) : requests;
 document.getElementById('walletHistory').innerHTML = historyList.length ?
  historyList.map(x=>`<div class="between" style="padding:8px 0"><span class="muted">${x.description}</span><b>${money(isPro ? x.net : x.gross)}</b></div>`).join('') :
  '<div class="empty">Nenhuma movimentação por enquanto.</div>';
}

function renderProfile(){
 const pro = role === 'profissional';
 document.getElementById('profileHeading').textContent = pro ? 'Perfil profissional' : 'Perfil do cliente';
 document.getElementById('profileName').textContent = user.name;
 document.getElementById('profileRole').textContent = pro ? `Profissional · ${user.skills.join(', ')}` : 'Cliente Tem Perto';
 document.getElementById('profileLocationMeta').textContent = `⌖ ${user.address} - ${user.neighborhood}, ${user.city}`;
 updateAvatarUI();

 const badgeWrap = document.getElementById('profileCredBadgeWrap');
 const credSec = document.getElementById('proCredSection');

 if (pro) {
  const info = getCredInfo();
  badgeWrap.innerHTML = `<span class="cred-badge ${info.badgeClass}"><span class="cred-dot"></span>${info.shortLabel}</span>`;
  credSec.classList.remove('hidden');

  let progressBar = '';
  if (cred.status === 'new') progressBar = `<div class="progress-track"><div class="progress-fill" style="width:${(cred.completedPixJobs/5)*100}%"></div></div>`;
  else if (cred.status === 'green') progressBar = `<div class="progress-track"><div class="progress-fill" style="width:${(cred.weeklyCompleted/5)*100}%;background:#1E9E63"></div></div>`;
  else if (cred.status === 'orange') progressBar = `<div class="progress-track"><div class="progress-fill" style="width:${(cred.recoveryStreak/10)*100}%;background:#D97706"></div></div>`;

  document.getElementById('proCredDetailCard').innerHTML = `
   <div class="between"><strong style="font-size:13px">${info.title}</strong></div>
   ${progressBar}
   <p class="muted" style="margin:8px 0 0;font-size:11.5px">${info.desc}</p>
   <hr>
   <div class="between" style="font-size:11px"><span class="muted">Concluídos na semana (Meta: 5):</span><strong>${cred.weeklyCompleted}/5</strong></div>
   <div class="between" style="font-size:11px;margin-top:4px"><span class="muted">Desistências após aceitar:</span><strong>${cred.cancellationsAfterAccept}</strong></div>
  `;

  document.getElementById('proOwnReviewsList').innerHTML = assignedProDemo.reviews.map(r => `
   <div class="card"><div class="between"><strong>${r.author}</strong><small class="muted">${r.date}</small></div>
   <p style="margin:6px 0 0;font-size:12px">${r.text}</p></div>
  `).join('');
 } else {
  badgeWrap.innerHTML = '';
  credSec.classList.add('hidden');
 }

 document.getElementById('profileStats').innerHTML = pro ?
  `<div class="stat"><strong>${cred.weeklyCompleted}/5</strong><small>Meta Semanal</small></div><div class="stat"><strong>${cred.cancellationsAfterAccept}</strong><small>Desistências</small></div><div class="stat"><strong>${cred.score ? cred.score.toFixed(1) : 'Novato'}</strong><small>Credibilidade</small></div>` :
  `<div class="stat"><strong>${requests.length}</strong><small>Pedidos</small></div><div class="stat"><strong>${money(clientWalletBalance)}</strong><small>Saldo</small></div><div class="stat"><strong>Verificado</strong><small>Conta</small></div>`;

 document.getElementById('profileDataCard').innerHTML = `
  <div class="meta">
   <strong>CPF:</strong> ${user.cpf}<br>
   <strong>Telefone:</strong> ${user.phone}<br>
   <strong>E-mail:</strong> ${user.email}<br>
   <strong>Endereço:</strong> ${user.address}, ${user.neighborhood} - ${user.city} (${user.cep})
   ${pro ? `<br><strong>Chave Pix (mesmo CPF):</strong> ${user.pix}` : ''}
  </div>
 `;

 const clientMenu = [
  ['♙','Editar dados e endereço','Atualizar nome, telefone ou endereço','editar'],
  ['▤','Meus pedidos','Acompanhe suas solicitações e chats','servicos'],
  ['▱','Carteira e recarga','Adicionar dinheiro ou ver histórico','carteira']
 ];
 const proMenu = [
  ['♙','Editar dados pessoais','Atualizar telefone ou endereço','editar'],
  ['▤','Meus serviços aceitos','Trabalhos em andamento e chats','servicos'],
  ['▱','Carteira e conta Pix','Saldo e dados bancários no seu CPF','carteira']
 ];

 document.getElementById('profileMenu').innerHTML = (pro ? proMenu : clientMenu).map(x=>
  `<button class="menu-item" onclick="menuAction('${x[3]}')"><span class="menu-icon">${x[0]}</span>
  <span><strong>${x[1]}</strong><small>${x[2]}</small></span><span class="arrow">›</span></button>`).join('');
}

function menuAction(a){
 if(a==='editar'){
  document.getElementById('editName').value = user.name;
  document.getElementById('editPhone').value = user.phone;
  document.getElementById('editEmail').value = user.email;
  document.getElementById('editAddress').value = user.address;
  document.getElementById('editCity').value = user.city;
  go('editar'); return;
 }
 go(a);
}

function saveProfile(){
 const newName = document.getElementById('editName').value.trim();
 if(newName) user.name = newName;
 user.phone = document.getElementById('editPhone').value.trim();
 user.email = document.getElementById('editEmail').value.trim();
 user.address = document.getElementById('editAddress').value.trim();
 user.city = document.getElementById('editCity').value.trim();
 document.getElementById('headerLocation').textContent = `⌖ ${user.neighborhood}, ${user.city}`;
 renderProfile();
 showToast('Dados atualizados com sucesso!');
 go('perfil');
}

function showToast(msg){
 const t=document.getElementById('toast'); t.textContent=msg; t.style.display='block';
 clearTimeout(window.toastTimer); window.toastTimer=setTimeout(()=>t.style.display='none',3200);
}
</script>
</body>
</html>
