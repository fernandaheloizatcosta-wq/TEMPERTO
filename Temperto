function renderCategories(){
 document.getElementById('categories').innerHTML=categories.map((c,i)=>
 `<button class="category" onclick="chooseCategory('${c[0]}')">${person(i)}<strong>${c[0]}</strong></button>`).join('');
}
function chooseCategory(name){ document.getElementById('categoryInput').value=name; updateMinPriceHint(); go('publicar'); }

function updateMinPriceHint() {
 const cat = document.getElementById('categoryInput').value;
 const min = minPrices[cat];
 const hint = document.getElementById('priceHint');
 document.getElementById('formWalletPreview').textContent = money(clientWalletBalance);
 if (min) {
  hint.textContent = `O piso para ${cat} (até 4h) é ${money(min)}. Você pode pagar esse valor ou mais.`;
 } else {
  hint.textContent = 'Selecione uma categoria acima para ver o piso.';
 }
}

function go(page){
 if(page==='home') page = role==='cliente' ? 'home' : 'prohome';
 if(role==='profissional' && (page==='home' || page==='publicar')) page='prohome';
 if(role==='cliente' && page==='prohome') page='home';

 document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
 document.getElementById(page).classList.add('active');
 document.querySelectorAll('.nav').forEach(x=>x.classList.toggle('active',x.dataset.page===page || (page==='prohome'&&x.dataset.page==='home')));
 if(page==='publicar') updateMinPriceHint();
 if(page==='servicos') renderServices();
 if(page==='perfil') renderProfile();
 if(page==='carteira') renderWallet();
 if(page==='home') renderRecent();
 if(page==='prohome') renderProOffers();
 window.scrollTo({top:0,behavior:'smooth'});
}

function clientOrderCard(item) {
 const isDone = item.status === 'Concluído';
 const canTip = isDone && !item.tipSent && (Date.now() - item.completedAt <= 30 * 60 * 1000);

 return `<div class="card">
  <div class="between"><span class="pill">${item.category} · até 4h</span><span class="muted"><strong>${item.status}</strong></span></div>
  <div class="offer-title">${item.description}</div>
  <div class="meta">⌖ ${item.neighborhood}, ${item.city}<br>◷ ${item.date} às ${item.time}<br>👷 Profissional: <strong>${assignedProDemo.name}</strong></div>
  <hr>
  <div class="between">
   <div><span class="muted">Valor pago</span><div class="price">${money(item.gross)}</div></div>
   <button class="secondary" onclick="openProPublicProfile()">Ver perfil e avaliar</button>
  </div>
  <div class="actions">
   ${!isDone ? `<button class="secondary" onclick="openOrderChat('${item.id}')">💬 Chat (abre às 08h)</button>
   <button class="primary" onclick="clientMarkDone('${item.id}')">Confirmar conclusão</button>` : ''}
   ${canTip ? `<button class="primary" onclick="openTipModal('${item.id}')">🎁 Enviar gorjeta (até 30 min)</button>` : ''}
   ${item.tipSent ? `<span class="pill" style="background:var(--green-bg);color:var(--green)">✓ Gorjeta de ${money(item.tipAmount)} enviada via Pix</span>` : ''}
  </div>
 </div>`;
}

function offerCard(item,pro=false,index=0){
 const displayValue=pro?item.net:item.gross;
 return `<div class="card">
 <div class="between"><span class="pill">${item.category} · até 4h</span><span class="muted">${item.status}</span></div>
 <div class="offer-title">${item.description}</div>
 <div class="meta">⌖ ${item.neighborhood}, ${item.city}<br>◷ ${item.date} às ${item.time}</div>
 <hr><div class="muted">${pro?'Você recebe (líquido)':'Valor do pedido'}</div>
 <div class="price">${money(displayValue)}</div>
 ${pro&&item.status==='Disponível'?`<div class="actions">
 <button class="primary" onclick="acceptOffer(${index})">Aceitar oferta</button>
 <button class="secondary" onclick="declineOffer()">Recusar</button></div>`:''}
 </div>`;
}

